# Токен бота от @BotFather (обязателен для отправки)
TG_BOT_TOKEN=
# Канал по умолчанию: @username или -100…
TG_DEFAULT_CHAT=
# Ваш числовой user id для кнопки «Мне в личку» (узнать: @userinfobot). Сначала напишите боту /start.
TG_PREVIEW_CHAT=
# Приём нажатий кнопок, первых комментариев, реакций и итогов опросов (getUpdates).
# Выключите (off), если этот бот уже работает где-то ещё с вебхуком или getUpdates.
# TG_UPDATES=on
# Ключ для API (заголовок X-API-Key). Оставьте пустым, если сервис доступен только с вашего компьютера.
STUDIO_API_KEY=
# Откуда брать свежую спецификацию Bot API и как часто проверять (часы)
# SPEC_URL=https://raw.githubusercontent.com/PaulSonOfLars/telegram-bot-api-spec/main/api.json
# SPEC_REFRESH_HOURS=12
# Адрес, по которому вы открываете студию: по нему агенты дают ссылки на черновик и предпросмотр
# STUDIO_URL=http://localhost:8080
# Дополнительные имена хоста через запятую, если открываете студию не как localhost
# ALLOWED_HOSTS=
# Свой сервер Bot API (нужен только для файлов > 50 МБ)
# TG_API_BASE=https://api.telegram.org
# Предел размера загрузки в МБ (по умолчанию 50, со своим сервером Bot API 2000)
# MAX_UPLOAD_MB=50
# Скачивание файла по ссылке (upload_media, /api/media/fetch) ходит только на публичные адреса.
# 1: разрешить localhost и локальную сеть (свой файловый сервер)
# MEDIA_FETCH_PRIVATE=0
# Агенты через MCP (/mcp) могут публиковать, откладывать и заменять посты. off: только черновики и предпросмотр,
# публикует человек из редактора
# MCP_PUBLISH=on
# Если в момент отложенной публикации студия или компьютер были выключены, пост уйдёт после запуска,
# только если опоздание не больше стольких минут; иначе он станет «пропущен» и ждёт вас. 0: отправлять всегда
# SCHEDULE_LATE_MIN=60
# Раз в сутки копия базы (черновики, посты, история) кладётся в ./data/backups, хранятся последние N. 0: выключить
# BACKUP_KEEP=7
# Журнал: строки JSON в ./data/logs/studio.log (его читают агенты: GET /api/logs, MCP studio_logs).
# Файл до LOG_MAX_MB МБ и LOG_FILES старых копий, больше места журнал не займёт. 0: только вывод контейнера
# LOG_LEVEL=INFO
# LOG_MAX_MB=5
# LOG_FILES=3
# Уборка того, что сделали вы. Загрузки, которые не упоминает ни один черновик и живой пост дольше N дней,
# удаляются (0: никогда, только по кнопке). У опубликованного поста хранятся последние N версий (0: все)
# MEDIA_UNUSED_DAYS=0
# VERSIONS_KEEP=0
