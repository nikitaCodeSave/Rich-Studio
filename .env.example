# Токен бота от @BotFather (обязателен для отправки)
TG_BOT_TOKEN=
# Канал по умолчанию: @username или -100…
TG_DEFAULT_CHAT=
# Ваш числовой user id для кнопки «Мне в личку» (узнать: @userinfobot). Сначала напишите боту /start.
TG_PREVIEW_CHAT=
# Приём нажатий кнопок, первых комментариев, реакций и итогов опросов (getUpdates).
# Выключите (off), если этот бот уже работает где-то ещё с вебхуком или getUpdates.
# TG_UPDATES=on
# Ключ для API (заголовок X-API-Key). Оставьте пустым, если сервис доступен только с вашего компьютера.
STUDIO_API_KEY=
# Откуда брать свежую спецификацию Bot API и как часто проверять (часы)
# SPEC_URL=https://raw.githubusercontent.com/PaulSonOfLars/telegram-bot-api-spec/main/api.json
# SPEC_REFRESH_HOURS=12
# Дополнительные имена хоста через запятую, если открываете студию не как localhost
# ALLOWED_HOSTS=
# Свой сервер Bot API (нужен только для файлов > 50 МБ)
# TG_API_BASE=https://api.telegram.org
# Предел размера загрузки в МБ (по умолчанию 50, со своим сервером Bot API 2000)
# MAX_UPLOAD_MB=50
