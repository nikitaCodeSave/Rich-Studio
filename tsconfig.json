{
  // Type check for the editor without a build: tsc reads the plain JS and JSDoc, emits nothing.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    // strict, except implicit any (JSDoc on every parameter is not worth it here) and unknown in catch
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": ["app/static/js/**/*.js", "types/*.d.ts"]
}
