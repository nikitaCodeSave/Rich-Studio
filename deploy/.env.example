# Copy to deploy/.env. The bot token goes to deploy/secrets/tg_bot_token, not here.
# The domain Caddy serves (DNS A/AAAA record → this server)
STUDIO_DOMAIN=studio.example.com
# Image tag: main (newest) or a commit sha from GHCR
# STUDIO_TAG=main
TG_DEFAULT_CHAT=
TG_PREVIEW_CHAT=
# Litestream replica of the database
LITESTREAM_REPLICA_URL=s3://my-bucket/rich-studio
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Dead man's switch: healthchecks.io check URL; it alerts you when the studio stops pinging
# DEADMAN_URL=https://hc-ping.com/<uuid>
# Everything else from ../.env.example works here too (RAW_API=off is a good idea on a server)
RAW_API=off
